#!/bin/sh
# Bricht den Commit ab, wenn Excel- oder Datendateien gestaged sind
# (das Repository ist oeffentlich).
verboten=$(git diff --cached --name-only --diff-filter=ACMR | grep -iE '(\.(xlsx|xls|xlsm)$)|(^|/)paschen-daten[^/]*$|\.tmp$|(^|/)backup/')
if [ -n "$verboten" ]; then
    echo "FEHLER: Diese Dateien duerfen nicht ins oeffentliche Repo:" >&2
    echo "$verboten" >&2
    exit 1
fi
exit 0
